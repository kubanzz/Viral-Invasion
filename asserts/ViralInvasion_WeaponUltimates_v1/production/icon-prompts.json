  "sources": {
    "icons.steady.sheet": {
      "title": "蜂巢针枪四技能图标母图",
      "ratio": "1:1",
      "resolution": "1K",
      "follow_up_node": [
        "af919e1e-ec11-43eb-b686-b28c8442cd2b"
      ],
      "outputMapping": [
