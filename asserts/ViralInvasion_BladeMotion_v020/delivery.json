  "integration": {
    "when": "Call once after GLTFLoader parses the medic, before starting live AnimationMixer; model transforms are restored.",
    "mixer": "Append returned clips to your clip Map; standard AnimationMixer only. Upper clips omit lower bones for locomotion blending; dash includes Sprint-derived lower body and must not also accumulate a second lower-body action at full weight.",
    "events": "Gameplay receipts are authoritative. Markers synchronize VFX/audio/hit presentation; do not generate damage, move the player or change cooldowns from animation.",
    "counter": "Interrupt guard on accepted parry/counter event; do not wait for guard .45s to end.",
    "dash": "Repeat per accepted FourfoldDash action phase; local marker hit does not imply four gameplay hits or autonomous root motion.",
    "sheath": "Pose only: existing redblade has no scabbard mesh, and this pack does not hide/scale the weapon to fake insertion."
  },
  "sources": {
    "software": "Three.js 0.187.0 AnimationMixer, QuaternionKeyframeTrack, CCDIKSolver",
